<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, then run launcher/build-and-install.sh (macOS) or launcher/build-windows.sh.
  Package names: adb shell pm list packages
  This copy is set up for a Xiaomi MiTV-MOOQ0 (Android TV 10, MediaTek); the original values were for a TCL Google TV.
-->
<resources>
    <!-- Dock apps, left to right. Apps that aren't installed (or are disabled) are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>it.rainet.androidtv</item>
        <item>com.mitv.tvhome.mitvplus</item>
        <item>com.spotify.tv.android</item>
        <item>org.videolan.vlc</item>
    </string-array>

    <!-- The only apps shown in the Kids profile (Live TV stays in the Inputs menu). -->
    <string-array name="kids_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>it.rainet.androidtv</item>
        <item>com.spotify.tv.android</item>
        <item>org.videolan.vlc</item>
        <item>com.ugreen.nasprotv</item>
    </string-array>

    <!-- Always ask for the PIN when these open, in every profile (Guard). -->
    <string-array name="always_pin_apps">
        <item>com.google.android.youtube.tv</item>
    </string-array>

    <!-- Ask for the PIN outside the Adult profile even though they may have no app icon. -->
    <string-array name="protected_apps">
        <item>com.android.tv.settings</item>
        <item>com.android.vending</item>
        <item>com.xiaomi.mitv.tvmanager</item>
    </string-array>

    <string name="guard_description" translatable="false">Pede o PIN dos adultos quando um app não liberado para o perfil atual é aberto.</string>

    <!-- Session lengths an adult can pick when unlocking the Kids profile, in minutes. -->
    <integer-array name="kids_minutes">
        <item>30</item>
        <item>60</item>
        <item>90</item>
    </integer-array>

    <!-- Never shown as tiles: the Live TV app (it's in the Inputs menu). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, listed last in the Inputs menu. Empty to leave it out.
         Common ones: com.tcl.tv (TCL), com.mediatek.wwtv.tvcenter (Xiaomi, many MediaTek sets),
         com.google.android.tv (Google Live Channels), com.sony.dtv.tvx (Sony). -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails. -->
    <string name="input_picker_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">5</integer>
</resources>
